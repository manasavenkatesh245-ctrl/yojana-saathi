# Copy to .env.local (local) or add in Vercel > Project > Settings > Environment Variables.
# Free key: https://console.groq.com/keys  (Groq free tier: chat agent, Whisper speech-to-text, document reading)
# Without a key the agent still works in offline mode (rule-based understanding, same tools, browser speech).
GROQ_API_KEY=

# Optional overrides
# GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b   # tried in order on rate limits / errors
# GROQ_STT_MODEL=whisper-large-v3
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
